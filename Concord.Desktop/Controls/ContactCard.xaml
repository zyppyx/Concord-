<UserControl x:Class="Concord___Definitive_Edition.Controls.ContactCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="80"
             Width="250">

    <Border x:Name="CardBorder"
            Background="{Binding CardBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CornerRadius="15"
            Margin="0,0,0,10"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">

        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         To="1.04"
                                         Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         To="1.04"
                                         Duration="0:0:0.12"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         To="1"
                                         Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         To="1"
                                         Duration="0:0:0.12"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid Margin="11">
            <Ellipse Width="45"
                     Height="45"
                     Fill="#5865F2"
                     HorizontalAlignment="Left"/>

            <Ellipse Width="45"
                     Height="45"
                     HorizontalAlignment="Left"
                     Opacity="{Binding ProfileImageOpacity, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding ProfileImage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>

            <TextBlock Text="{Binding Initial, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Width="45"
                       Height="45"
                       Opacity="{Binding InitialOpacity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"
                       Padding="0,10,0,0"
                       HorizontalAlignment="Left"/>

            <Ellipse Width="12"
                     Height="12"
                     Fill="{Binding StatusBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Stroke="#252836"
                     StrokeThickness="2"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="32,0,0,5"/>

            <StackPanel Margin="60,0,0,0">
                <TextBlock Text="{Binding FriendName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#A0A0B8"
                           FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
