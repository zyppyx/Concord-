<Window x:Class="Concord___Definitive_Edition.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar conta"
        Height="430"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#14151D">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Criar conta"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,22"/>

        <TextBox x:Name="UsernameBox"
                 
                 Grid.Row="1"
                 Height="44"
                 FontSize="16"
                 Padding="12"
                 Margin="0,0,0,12"
                 Background="#252836"
                 Foreground="Gray"
                 Text="Nome de Usuário"
                 BorderThickness="0" PreviewMouseDown="UsernameBox_PreviewMouseDown"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <PasswordBox x:Name="PasswordBox"
                         Height="44"
                         FontSize="16"
                         Padding="12"
                         Background="#252836"
                         Foreground="White"
                         BorderThickness="0"/>

            <TextBox x:Name="PasswordTextBox"
                     Height="44"
                     FontSize="16"
                     Padding="12"
                     Background="#252836"
                     Foreground="White"
                     BorderThickness="0"
                     Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="3">
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="44"
                         FontSize="16"
                         Padding="12"
                         Background="#252836"
                         Foreground="White"
                         BorderThickness="0"/>

            <TextBox x:Name="ConfirmPasswordTextBox"
                     Height="44"
                     FontSize="16"
                     Padding="12"
                     Background="#252836"
                     Foreground="White"
                     BorderThickness="0"
                     Visibility="Collapsed"/>
        </Grid>

        <CheckBox x:Name="ShowPasswordCheckBox"
                  Grid.Row="4"
                  Content="Revelar senha"
                  Foreground="#A0A0B8"
                  Margin="0,10,0,0"
                  Checked="ShowPasswordCheckBox_Changed"
                  Unchecked="ShowPasswordCheckBox_Changed"/>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="5"
                   Foreground="#FFB86B"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Cancelar"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="2"
                    Content="Criar"
                    Height="40"
                    Background="#5865F2"
                    Foreground="White"
                    Click="CreateButton_Click"/>
        </Grid>
    </Grid>
</Window>
