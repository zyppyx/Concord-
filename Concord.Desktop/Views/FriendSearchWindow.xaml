<Window x:Class="Concord___Definitive_Edition.FriendSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amigos"
        Height="580"
        Width="560"
        MinHeight="520"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#14151D">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Encontrar amigos"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="IdBox"
                     Height="42"
                     FontSize="15"
                     Padding="10"
                     Background="#252836"
                     Foreground="White"
                     BorderThickness="0"/>

            <TextBox x:Name="UsernameBox"
                     Grid.Column="1"
                     Height="42"
                     FontSize="15"
                     Padding="10"
                     Margin="12,0"
                     Background="#252836"
                     Foreground="White"
                     BorderThickness="0"/>

            <Button Grid.Column="2"
                    Content="Buscar"
                    Height="42"
                    Background="#5865F2"
                    Foreground="White"
                    Click="SearchButton_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="#1A1B24"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="52"
                         Height="52"
                         Fill="#5865F2"
                         HorizontalAlignment="Left">
                    <Ellipse.OpacityMask>
                        <ImageBrush x:Name="ResultImageBrush"/>
                    </Ellipse.OpacityMask>
                </Ellipse>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ResultNameText"
                               Text="Busque por ID ou nome"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ResultInfoText"
                               Text="O resultado aparece aqui"
                               Foreground="#A0A0B8"
                               FontSize="13"/>
                </StackPanel>

                <Button x:Name="SendRequestButton"
                        Grid.Column="2"
                        Content="Adicionar"
                        Height="40"
                        IsEnabled="False"
                        Click="SendRequestButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Pedidos recebidos"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <ListBox x:Name="RequestsList"
                     Grid.Row="1"
                     Background="#252836"
                     Foreground="White"
                     BorderThickness="0"/>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Foreground="#FFB86B"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="1"
                        Content="Atualizar"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="RefreshRequestsButton_Click"/>

                <Button Grid.Column="2"
                        Content="Aceitar"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="AcceptRequestButton_Click"/>

                <Button Grid.Column="3"
                        Content="Recusar"
                        Height="38"
                        Click="RejectRequestButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
