<Window x:Class="Concord___Definitive_Edition.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Concord"
        Height="720"
        Width="1300"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#14151D">

    <Window.Resources>
        <Style x:Key="ChatInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#20212A"/>
            <Setter Property="Foreground" Value="#F5F3FF"/>
            <Setter Property="CaretBrush" Value="#F5F3FF"/>
            <Setter Property="BorderBrush" Value="#3E4050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#908E9B"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="20,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#5865F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Banner offline (oculto por padrão) -->
            <RowDefinition Height="Auto"/>
            <!-- Conteúdo principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Banner offline ─────────────────────────────────────────────── -->
        <Border x:Name="OfflineBanner"
                Grid.Row="0"
                Background="#CC3B3B"
                Visibility="Collapsed"
                Padding="12,6">
            <TextBlock Text="⚠ Sem conexão com a internet"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ── Layout principal ───────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar esquerda -->
            <Border Background="#101117">
                <StackPanel Margin="10">
                    <Border Height="60" CornerRadius="15" Background="#5865F2" Margin="0,0,0,12">
                        <TextBlock Text="C"
                                   FontSize="28"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button x:Name="LoginButton"
        Margin="0,0,0,10"
        ToolTip="Conta"
        Click="LoginButton_Click">

                        <iconPacks:PackIconMaterial
        Kind="AccountCircle"
        Width="24"
        Height="24"
        Foreground="#F2F0FF"/>

                    </Button>
                </StackPanel>
            </Border>

            <!-- Painel de conversas -->
            <Border Background="#1A1B24" Grid.Column="1">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Conversas"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <!-- Loading indicator -->
                    <TextBlock x:Name="LoadingText"
                               DockPanel.Dock="Top"
                               Text="⏳ Carregando conversas..."
                               Foreground="#A0A0B8"
                               FontSize="13"
                               Margin="0,0,0,10"
                               Visibility="Collapsed"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ContactsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Área de chat -->
            <Grid Grid.Column="2" Margin="17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Border Background="#1A1B24"
                        BorderBrush="#30323D"
                        BorderThickness="1"
                        CornerRadius="8,8,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="25,0">
                        <TextBlock x:Name="ChatTitle"
                                   Text="Escolha uma conversa"
                                   Foreground="White"
                                   FontSize="24"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Entre na sua conta para começar"
                                   Foreground="#A0A0B8"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Mensagens -->
                <Border Grid.Row="1"
                        Background="#23242C"
                        BorderBrush="#3A3C49"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8">
                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MessagesPanel" Margin="20"/>
                    </ScrollViewer>
                </Border>

                <!-- Loading de mensagens -->
                <Border Grid.Row="2"
                        Background="#1E1F2B"
                        Padding="12,6"
                        Margin="0,2,0,0"
                        CornerRadius="6"
                        Visibility="{Binding Visibility, ElementName=ChatLoadingText}">
                    <TextBlock x:Name="ChatLoadingText"
                               Text="⏳ Carregando mensagens..."
                               Foreground="#A0A0B8"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Border>

                <!-- Input area -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botão de anexo (foto/arquivo) -->
                    <Button x:Name="AttachButton"
        Grid.Column="0"
        Width="48"
        Height="58"
        Margin="0,0,8,0"
        ToolTip="Enviar foto ou arquivo"
        IsEnabled="False"
        Click="AttachButton_Click"
        FontSize="20">

                        <iconPacks:PackIconMaterial
        Kind="Paperclip"
        Width="20"
        Height="20"
        Foreground="White"/>

                    </Button>

                    <!-- Campo de texto -->
                    <TextBox x:Name="MessageTextBox"
                             Grid.Column="1"
                             Style="{StaticResource ChatInputStyle}"
                             Height="58"
                             Tag="Digite uma mensagem..."
                             KeyDown="MessageTextBox_KeyDown"/>

                    <!-- Botão de áudio -->
                    <Button x:Name="AudioButton"
        Grid.Column="2"
        Width="48"
        Height="58"
        Margin="8,0,8,0"
        ToolTip="Gravar e enviar áudio"
        IsEnabled="False"
        Click="AudioButton_Click"
        FontSize="20">

                        <iconPacks:PackIconMaterial
        Kind="Microphone"
        Width="20"
        Height="20"
        Foreground="White"/>

                    </Button>

                    <!-- Enviar -->
                    <Button x:Name="SendButton"
                            Grid.Column="3"
                            Height="58"
                            FontSize="17"
                            Content="Enviar"
                            IsEnabled="False"
                            Click="SendButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
