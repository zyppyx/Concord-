<Window x:Class="Concord___Definitive_Edition.AccountManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conta"
        Height="560"
        Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#14151D">
    <Border Margin="18"
            Background="#1A1B24"
            BorderBrush="#30323D"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Gerenciar conta"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="UsernameText"
                           Foreground="#A0A0B8"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,18"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Button Content="Foto de perfil"
                        Margin="0,0,0,10"
                        Click="PhotoButton_Click"/>

                <Button Content="Encontrar amigos"
                        Margin="0,0,0,10"
                        Click="FindFriendsButton_Click"/>

                <Button Content="Pedidos de amizade"
                        Margin="0,0,0,10"
                        Click="FriendRequestsButton_Click"/>

                <Button Content="Atualizar contatos"
                        Margin="0,0,0,10"
                        Click="RefreshButton_Click"/>

                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Iniciar com o Windows"
                          Foreground="#A0A0B8"
                          Margin="0,2,0,12"
                          Checked="StartWithWindowsCheckBox_Changed"
                          Unchecked="StartWithWindowsCheckBox_Changed"/>
            </StackPanel>

            <Button Grid.Row="2"
                    Content="Sair da conta"
                    Margin="0,10,0,8"
                    Click="LogoutButton_Click"/>

            <!-- Excluir conta — botão vermelho separado -->
            <Button x:Name="DeleteAccountButton"
                    Grid.Row="3"
                    Content="⚠ Excluir conta permanentemente"
                    Margin="0,0,0,0"
                    Background="#7A1515"
                    Foreground="White"
                    BorderBrush="#CC2222"
                    Click="DeleteAccountButton_Click"/>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Foreground="#FFB86B"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
        </Grid>
    </Border>
</Window>
